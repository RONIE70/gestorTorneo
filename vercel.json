{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "rewrites": [
   
    { "source": "/fichar", "destination": "server/index.js" },
    { "source": "/dashboard-resumen", "destination": "server/index.js" },
    { "source": "/jugadoras/:path*", "destination": "server/index.js" },

   
    { "source": "/verificar/:id*", "destination": "/index.html" },
    { "source": "/mastercontrol", "destination": "/index.html" },
    { "source": "/AdminDelegado", "destination": "/index.html" },
    { 
      "src": "/(.*)", 
      "dest": "/index.html",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    }
  ]
}